# ==========================================
# DATA WRANGLING AND PREPROCESSING USING R
# ==========================================

library(tidyverse)
library(janitor)

# 1. Import Dataset
data <- read_csv(
  "data/student_performance_raw_with_issues.csv"
)

# 2. Initial Inspection
head(data)
tail(data)
dim(data)
names(data)
str(data)
summary(data)

# 3. Missing Value Check
colSums(is.na(data))
sum(is.na(data))

# 4. Duplicate Check
sum(duplicated(data))

# 5. Correct Data Types
data <- data %>%
  mutate(
    studytime = as.numeric(studytime),
    absences = as.numeric(absences),
    G1 = as.numeric(G1),
    G2 = as.numeric(G2),
    G3 = as.numeric(G3)
  )

# 6. Standardize Text
data <- data %>%
  mutate(
    sex = str_trim(str_to_upper(sex)),
    school = str_trim(str_to_upper(school))
  )

# 7. Correct Categorical Values
data$sex <- recode(
  data$sex,
  "MALE" = "M",
  "FEMALE" = "F"
)

# 8. Convert Categorical Variables
data$sex <- as.factor(data$sex)
data$school <- as.factor(data$school)

# 9. Handle Missing Values
data$absences <- ifelse(
  is.na(data$absences),
  median(data$absences, na.rm = TRUE),
  data$absences
)

# 10. Remove Duplicates
data <- data %>%
  distinct()

# 11. Validate Final Grade
data$G3 <- pmin(
  pmax(data$G3, 0),
  20
)

# 12. Feature Extraction
data <- data %>%
  mutate(
    total_grade = G1 + G2 + G3,
    average_grade = (G1 + G2 + G3) / 3
  )

# 13. Performance Category
data <- data %>%
  mutate(
    pass_status = ifelse(
      G3 >= 10,
      "Pass",
      "Below Pass"
    )
  )

# 14. Categorical Encoding
data <- data %>%
  mutate(
    sex_encoded = ifelse(
      sex == "M",
      1,
      0
    )
  )

# 15. Min-Max Scaling
data <- data %>%
  mutate(
    absences_scaled =
      (absences - min(absences)) /
      (max(absences) - min(absences))
  )

# 16. Final Validation
print(dim(data))
print(str(data))
print(summary(data))

cat(
  "Missing Values:",
  sum(is.na(data)),
  "\n"
)

cat(
  "Duplicate Rows:",
  sum(duplicated(data)),
  "\n"
)

# 17. Save Clean Dataset
write_csv(
  data,
  "data/student_performance_cleaned.csv"
)
