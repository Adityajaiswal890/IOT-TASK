#include <Keypad.h>
#include <Servo.h>

Servo doorLock;
const byte ROWS = 4, COLS = 4;
char keys[ROWS][COLS] = {
  {'1','2','3','A'}, {'4','5','6','B'},
  {'7','8','9','C'}, {'*','0','#','D'}
};
byte rowPins[ROWS] = {9, 8, 7, 6};
byte colPins[COLS] = {5, 4, 3, 2};
Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

String password = "1234", entered = "";

void setup() {
  Serial.begin(9600);
  doorLock.attach(10);
  doorLock.write(0); // 🔒 Locked position
}

void loop() {
  char key = keypad.getKey();
  if (key) {
    if (key == '#') {
      if (entered == password) {
        Serial.println("Access Granted");
        doorLock.write(90); // 🔓 Unlocked
        delay(5000);
        doorLock.write(0);  // 🔒 Auto-lock
      } else {
        Serial.println("Access Denied");
      }
      entered = "";
    } else if (key == '*') {
      entered = "";
    } else {
      entered += key;
    }
  }
}
