library(tidyverse)
library(caret)
library(rpart)
library(rpart.plot)
library(pROC)


# ============================================================
# 3. SET RANDOM SEED
# ============================================================
# This makes the analysis reproducible.

set.seed(42)


# ============================================================
# 4. CREATE OUTPUT FOLDER
# ============================================================

if (!dir.exists("output")) {
  dir.create("output")
}

if (!dir.exists("output/plots")) {
  dir.create("output/plots")
}


# ============================================================
# 5. LOAD DATASET
# ============================================================

data <- read_csv(
  "data/student_performance_modeling.csv"
)


# ============================================================
# 6. INITIAL DATA INSPECTION
# ============================================================

# Display first rows
head(data)

# Display structure
str(data)

# Display number of rows and columns
dim(data)

# Display column names
names(data)

# Display summary statistics
summary(data)


# ============================================================
# 7. CHECK DATA QUALITY
# ============================================================

# Check missing values
missing_values <- colSums(is.na(data))

print(missing_values)


# Check duplicate rows
duplicate_rows <- sum(duplicated(data))

cat(
  "Number of duplicate rows:",
  duplicate_rows,
  "\n"
)


# ============================================================
# 8. PREPARE TARGET VARIABLE
# ============================================================
# The target variable is Pass/Below Pass.

data$pass_status <- factor(
  data$pass_status,
  levels = c("Below Pass", "Pass")
)


# ============================================================
# 9. BASIC DATA SUMMARY
# ============================================================

cat("\nDataset Summary\n")
cat("------------------------\n")

cat(
  "Number of observations:",
  nrow(data),
  "\n"
)

cat(
  "Number of variables:",
  ncol(data),
  "\n"
)

cat(
  "Average G1:",
  mean(data$G1, na.rm = TRUE),
  "\n"
)

cat(
  "Average G2:",
  mean(data$G2, na.rm = TRUE),
  "\n"
)

cat(
  "Average absences:",
  mean(data$absences, na.rm = TRUE),
  "\n"
)


# ============================================================
# 10. TARGET VARIABLE DISTRIBUTION
# ============================================================

target_table <- table(data$pass_status)

print(target_table)

target_percentage <- prop.table(target_table) * 100

print(target_percentage)


# ============================================================
# 11. VISUALIZATION 1 - PASS STATUS
# ============================================================

plot_pass <- ggplot(
  data,
  aes(x = pass_status)
) +
  geom_bar() +
  labs(
    title = "Student Pass Status Distribution",
    x = "Pass Status",
    y = "Number of Students"
  ) +
  theme_minimal()

print(plot_pass)


# Save plot
ggsave(
  "output/plots/pass_status_distribution.png",
  plot_pass,
  width = 7,
  height = 5
)


# ============================================================
# 12. VISUALIZATION 2 - STUDY TIME
# ============================================================

plot_studytime <- ggplot(
  data,
  aes(x = studytime)
) +
  geom_bar() +
  labs(
    title = "Distribution of Weekly Study Time",
    x = "Study Time Category",
    y = "Number of Students"
  ) +
  theme_minimal()

print(plot_studytime)

ggsave(
  "output/plots/study_time_distribution.png",
  plot_studytime,
  width = 7,
  height = 5
)


# ============================================================
# 13. VISUALIZATION 3 - ABSENCES VS FINAL STATUS
# ============================================================

plot_absences <- ggplot(
  data,
  aes(
    x = pass_status,
    y = absences
  )
) +
  geom_boxplot() +
  labs(
    title = "Absences by Student Pass Status",
    x = "Pass Status",
    y = "Number of Absences"
  ) +
  theme_minimal()

print(plot_absences)

ggsave(
  "output/plots/absences_by_status.png",
  plot_absences,
  width = 7,
  height = 5
)


