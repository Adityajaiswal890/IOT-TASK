#include <Keypad.h>
#include <Servo.h>

// ⚙️ Servo setup
Servo doorLock;
const int servoPin = 10;

// 🔢 Keypad setup (4x4 matrix)
const byte ROWS = 4;
const byte COLS = 4;
char keys[ROWS][COLS] = {
  {'1', '2', '3', 'A'},
  {'4', '5', '6', 'B'},
  {'7', '8', '9', 'C'},
  {'*', '0', '#', 'D'}
};

byte rowPins[ROWS] = {9, 8, 7, 6}; 
byte colPins[COLS] = {5, 4, 3, 2}; 

Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

// 🔑 Password settings
String correctPassword = "1234"; // Default password
String enteredPassword = "";

void setup() {
  Serial.begin(9600);
  doorLock.attach(servoPin);
  
  // Darwaza pehle se Lock position par set karein (0 degree)
  doorLock.write(0); 
  Serial.println("Door is LOCKED. Enter 4-digit password:");
}

void loop() {
  char key = keypad.getKey();

  if (key) {
    Serial.print("*"); // Privacy ke liye '*' print karega
    
    // '#' dabane par password check hoga
    if (key == '#') {
      checkPassword();
    } 
    // '*' dabane par input clear ho jayega
    else if (key == '*') {
      enteredPassword = "";
      Serial.println("\nInput cleared. Try again:");
    } 
    else {
      enteredPassword += key;
    }
  }
}

void checkPassword() {
  Serial.println();
  if (enteredPassword == correctPassword) {
    Serial.println("✅ Access Granted! Door UNLOCKED.");
    doorLock.write(90); // Unlock position
    delay(5000);        // 5 seconds wait
    
    doorLock.write(0);  // Auto-lock again
    Serial.println("🔒 Door Auto-LOCKED.");
  } else {
    Serial.println("❌ Wrong Password! Access Denied.");
  }
  enteredPassword = ""; // Reset entered string
}
